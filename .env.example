# ==== Group B extraction (src/extract.py) ====
# The pipeline auto-picks a provider: if GOOGLE_API_KEY is set it uses Google
# AI Studio's FREE Gemini tier; otherwise it uses OpenRouter. Set just one.

# Google AI Studio -- free, no credit card, works from anywhere.
# Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# OpenRouter (paid) -- alternative. https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional overrides (defaults live in src/config.py):
#   EXTRACT_PROVIDER=google        # force a provider: google | openrouter
#   EXTRACT_MODEL=google/gemini-2.5-flash   # the "google/" prefix is stripped
#                                           # automatically for the Google endpoint
#   EXTRACT_MIN_INTERVAL_S=4.5      # seconds between calls (rate-limit pacing)
